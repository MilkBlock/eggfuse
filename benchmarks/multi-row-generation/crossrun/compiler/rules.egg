(relation A (i64 i64 i64))
(relation B (i64 i64 i64))
(relation Pair (i64 i64 i64 i64 i64))
(relation Request (i64 i64 i64))
(relation Result (i64 i64 i64 i64 i64))
(ruleset make)
(ruleset finish)
(rule ((A i k x) (B j k y)) ((Pair i j k x y)) :ruleset make)
(rule ((Pair i j k x y) (Request i j t)) ((Result i j t x y)) :ruleset finish)
