(relation IQuery (i64 i64))
(relation IAnchor (i64 i64))
(relation ICompared (i64 i64 i64))
(relation ITagged (i64 i64 i64))
(relation IResult (i64 i64 i64 i64))
(ruleset ia)
(ruleset ib)
(ruleset ic)
(rule ((IQuery i j)) ((IAnchor i j)) :ruleset ia)
(rule ((IAnchor i j) (Observe i x) (Observe j x)) ((ICompared i j 1)) :ruleset ib)
(rule ((IAnchor i j) (Observe i x) (Observe j y) (!= x y)) ((ICompared i j 0)) :ruleset ib)
(rule ((ICompared i j old)) ((ITagged i j old)) :ruleset ib)
(rule ((ITagged i j old) (Observe i x) (Observe j x)) ((IResult i j old 1)) :ruleset ic)
(rule ((ITagged i j old) (Observe i x) (Observe j y) (!= x y)) ((IResult i j old 0)) :ruleset ic)
