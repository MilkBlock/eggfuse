(relation InP0 (i64 i64 i64))
(relation InP1 (i64 i64 i64))
(relation InU (i64 i64 i64))
(relation P0 (i64 i64))
(relation P1 (i64 i64))
(relation U (i64 i64))
(relation C (i64 i64 i64))
(relation V (i64 i64))
(ruleset wave0)
(ruleset wave1)
(ruleset wave2)
(ruleset finish)
(rule ((InP0 0 k x)) ((P0 k x)) :ruleset wave0)
(rule ((InP1 0 k y)) ((P1 k y)) :ruleset wave0)
(rule ((InU 0 k z)) ((U k z)) :ruleset wave0)
(rule ((InP0 1 k x)) ((P0 k x)) :ruleset wave1)
(rule ((InP1 1 k y)) ((P1 k y)) :ruleset wave1)
(rule ((InU 1 k z)) ((U k z)) :ruleset wave1)
(rule ((InP0 2 k x)) ((P0 k x)) :ruleset wave2)
(rule ((InP1 2 k y)) ((P1 k y)) :ruleset wave2)
(rule ((InU 2 k z)) ((U k z)) :ruleset wave2)
(rule ((P0 k x) (P1 k y)) ((C k x y)) :ruleset finish)
(rule ((U k z)) ((V k z)) :ruleset finish)
