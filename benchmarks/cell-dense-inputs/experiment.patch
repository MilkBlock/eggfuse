+impl InputSlots {
+    /// Query fields follow this shared layout. Do not rebuild a map on the
+    /// RHS side: the returned owned storage also belongs to the Cell instance.
+    pub(crate) fn bind(&self, values: impl ExactSizeIterator<Item = Value>) -> crate::slots::Slots {
+        assert_eq!(values.len(), self.len(), "Cell input layout width");
+        if self.0.dense { crate::slots::Slots::dense(values) }
+        else { self.iter().copied().zip(values).collect() }
+    }
