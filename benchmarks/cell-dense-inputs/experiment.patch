+#[cfg(test)]
+mod input_layout_tests {
+    use super::*;
+    #[test]
+    fn binding_uses_layout_order_and_preserves_serialization() {
+        for ids in [vec![], vec![0, 1, 2, 3], vec![0, 3, 4, 2], vec![1, 1000]] {
+            let input: InputSlots = ids.clone().into();
+            let values: Vec<_> = (0..ids.len()).map(|i| Value::Int(i as i64)).collect();
+            let slots = input.bind(values.clone().into_iter());
+            let expected: crate::slots::Slots = ids.iter().copied().zip(values).collect();
+            assert_eq!(slots, expected);
+            assert_eq!(matches!(slots, crate::slots::Slots::Dense { .. }), ids.iter().copied().eq(0..ids.len()));
+            let encoded = serde_json::to_string(&input).unwrap();
+            assert_eq!(encoded, serde_json::to_string(&ids).unwrap());
+            let decoded: InputSlots = serde_json::from_str(&encoded).unwrap();
+            assert_eq!(decoded.as_ref(), &ids);
+            assert_eq!(decoded.0.dense, input.0.dense);
+        }
+    }
+    #[test]
+    #[should_panic(expected = "Cell input layout width")]
+    fn binding_rejects_a_missing_input() {
