; Repeated root fields must reject Start(9,10) before publishing any prefix.
; Failed scalar-prefix branches must release their new slots for siblings.
; Later Runs invalidate/rebuild the same root and then extend terminal deltas.
(relation Start (i64 i64)) (relation Edge (i64 i64)) (relation Tail (i64 i64))
(relation Hit (i64 i64 i64))
(relation Linear (i64 i64))
(ruleset see) (ruleset grow) (ruleset cut) (ruleset late)
(rule ((Start x x) (Edge x y) (= k (+ y 1)) (< k 5) (Tail k z))
      ((Hit x y z)) :ruleset see :name "guarded-prefix")
(rule ((Start x x) (= k (+ x 1)) (Tail k z))
      ((Linear x z)) :ruleset see :name "linear-prefix")
(rule ((Start x x)) ((Edge x 3)) :ruleset grow)
(rule ((Start x x)) ((delete (Edge x 2))) :ruleset cut)
(rule ((Start x x)) ((Tail 2 99)) :ruleset late)
(Start 1 1) (Start 9 10) (Edge 9 1) (Edge 1 1) (Edge 1 2) (Edge 1 6)
(Tail 2 11) (Tail 3 12) (Tail 4 13) (Tail 7 90) (Tail 8 91)
(run-schedule (seq (run see) (run grow) (run see) (run cut) (run see)
                   (run late) (run see)))
(check (Hit 1 1 11) (Hit 1 2 12) (Hit 1 3 13) (Hit 1 1 99) (Linear 1 11) (Linear 1 99))
