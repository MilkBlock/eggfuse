(function Row (i64 i64) i64 :merge new)
(function Limit (i64) i64 :merge new)
(function Found (i64 i64 i64) Unit :merge old)
(ruleset select) (ruleset change) (ruleset restore)
(rule ((= threshold (Limit group)) (= score (Row group n)) (< score threshold))
      ((set (Found group n score) ())) :ruleset select)
(rule ((= threshold (Limit group)))
      ((set (Row group 5) 50) (delete (Row group 6)) (set (Row group 64) 1)
       (set (Limit group) 16)) :ruleset change)
(rule ((= threshold (Limit group)))
      ((set (Row group 6) 6) (set (Limit group) 70)) :ruleset restore)
