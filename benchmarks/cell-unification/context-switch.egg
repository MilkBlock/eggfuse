; Change the cheapest root twice while each retained read scope stays live.
(relation Start (i64)) (relation Edge (i64 i64)) (relation Tail (i64 i64))
(relation Hit (i64 i64)) (relation Linear (i64))
(ruleset see) (ruleset grow) (ruleset trim) (ruleset late)
(rule ((Start x) (Edge x y) (Tail y z))
      ((Hit x z)) :ruleset see :name "guarded-prefix")
(rule ((Start x) (Tail x z))
      ((Linear z)) :ruleset see :name "linear-prefix")
(rule ((Start 1)) ((Start 2) (Start 3) (Start 4) (Start 5)) :ruleset grow)
(rule ((Start 1)) ((delete (Start 2)) (delete (Start 3))
                   (delete (Start 4)) (delete (Start 5))) :ruleset trim)
(rule ((Start 1)) ((Tail 2 99)) :ruleset late)
(Start 1) (Edge 1 2) (Edge 1 3) (Edge 2 2) (Edge 5 2)
(Tail 2 22) (Tail 3 33)
(run-schedule (seq (run see) (run grow) (run see) (run trim) (run see)
                   (run late) (run see)))
(check (Hit 1 22) (Hit 1 33) (Hit 2 22) (Hit 5 22) (Hit 1 99)
       (Linear 22) (Linear 33))
