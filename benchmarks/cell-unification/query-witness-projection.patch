+
+#[test]
+fn query_with_no_exported_witness_keeps_no_intermediate_receipt_list() {
+    let source = r#"
+(datatype E (N i64) (Start E) (F E) (Gateway E) (Out E))
+(ruleset make) (ruleset consume)
+(rule ((Start x)) ((F x) (Gateway x)) :ruleset make)
+(rule ((Gateway x) (F x)) ((Out x)) :ruleset consume)
+(Start (N 1))
+(run-schedule (seq (run make) (run consume)))
+(check (Out (N 1)))
+"#;
+    let (_, nodes) = compare_mode(source, false);
+    let report = nodes.report();
+    let s = &report["stage_spine"]["stats"];
+    assert!(s["cell_query_steps"].as_u64().unwrap() > 0, "exercise a non-pivot read: {s}");
+    assert!(s["cell_query_witness_dispatches"].as_u64().unwrap() > 0);
+    assert_eq!(s["cell_query_witness_writes"], 0, "{s}");
+    assert_eq!(s["cell_query_witness_checks"], 0, "empty demand has no per-row filter");
+}
+
+#[test]
+fn single_query_witness_survives_other_ports_and_pivot_choices() {
+    let source = r#"
+(datatype E (N i64) (Start E) (F E) (H E) (J E) (Gateway E) (Out E))
+(ruleset make) (ruleset consume)
+(rule ((Start x)) ((F x) (H x) (J x) (Gateway x)) :ruleset make)
+(rule ((Gateway x) (F x) (H x) (J x)) ((F x) (Out x)) :ruleset consume)
+(Start (N 1))
+(run-schedule (seq (run make) (run consume)))
+(check (Out (N 1)))
+"#;
+    let (_, nodes) = compare_mode(source, false);
+    let report = nodes.report();
+    let s = &report["stage_spine"]["stats"];
+    assert!(s["alias_query_forwards"].as_u64().unwrap() > 0, "retain the requested F receipt");
+    assert!(s["cell_query_witness_checks"].as_u64().unwrap()
+        > s["cell_query_witness_writes"].as_u64().unwrap(), "do not retain unrelated ports: {s}");
+}
