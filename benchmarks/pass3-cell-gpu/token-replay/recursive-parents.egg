(datatype E (LeftSeed i64) (RightSeed i64) (L i64) (R i64) (Pair E E) (Use E))
(ruleset produce)
(ruleset combine)
(ruleset consume)
(rule ((LeftSeed i)) ((L i)) :ruleset produce)
(rule ((RightSeed i)) ((R i) (R (+ i 1))) :ruleset produce)
(rule ((= l (L i)) (= r (R i))) ((Pair l r)) :ruleset combine)
(rule ((= p (Pair l r))) ((Use p)) :ruleset consume)
(LeftSeed 7)
(RightSeed 7)
(RightSeed 19)
(run-schedule (seq (run produce) (run combine) (run consume)))
