(datatype Expr (Atom i64))
(sort ExprSetPrim (Set Expr))
(datatype ExprSet (ES ExprSetPrim))
(function ExprSet-length (ExprSet) i64 :no-merge)
(ruleset before)
(ruleset alias)
(ruleset memory-helpers)
(function Observed (i64) i64 :no-merge)
(rule ((ES xs)) ((set (Observed 0) (set-length xs))) :ruleset before)
(rule ((= a (Atom 1)) (= b (Atom 2))) ((union a b)) :ruleset alias)
(rule ((= s (ES xs))) ((set (ExprSet-length s) (set-length xs))) :ruleset memory-helpers)
(ES (set-of (Atom 1) (Atom 2)))
(run-schedule (seq (run before) (run alias) (run memory-helpers) (run memory-helpers)))
