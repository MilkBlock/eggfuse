(datatype Expr (Atom i64))
(sort ExprSetPrim (Set Expr))
(datatype ExprSet (ES ExprSetPrim))
(relation Seed (i64))
(ruleset make)
(ruleset observe)
(ruleset alias)
(function Size (ExprSet) i64 :merge (min old new))
(rule ((Seed n))
      ((let a (Atom n)) (let b (Atom (+ n 1)))
       (let xs (set-insert (set-empty) a))
       (ES (set-union xs (set-of b))))
      :ruleset make)
(rule ((= s (ES xs))) ((set (Size s) (set-length xs))) :ruleset observe)
(rule ((= a (Atom 1)) (= b (Atom 2))) ((union a b)) :ruleset alias)
(Seed 1)
(run-schedule (seq (run make) (run observe) (run alias) (run observe) (run observe)))
