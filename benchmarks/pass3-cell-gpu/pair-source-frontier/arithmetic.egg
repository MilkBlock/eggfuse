(datatype Node (Inputs i64 i64 i64) (Targets i64 i64 i64)
               (AddHit i64 i64) (SubHit i64 i64) (MulHit i64 i64))
(ruleset derive)
(rule ((= parent (Inputs g a b)) (= target (Targets g expected tag)) (= expected (+ a b)))
      ((AddHit a tag)) :ruleset derive)
(rule ((= target (Targets g expected tag)) (= parent (Inputs g a b)) (= expected (- a b)))
      ((SubHit b tag)) :ruleset derive)
(rule ((= parent (Inputs g a b)) (= target (Targets g expected tag)) (= expected (* a b)))
      ((MulHit b tag)) :ruleset derive)
(Inputs 0 3 2)
(Inputs 0 -3 2)
(Inputs 1 9223372036854775807 1)
(Targets 0 5 10)
(Targets 0 1 11)
(Targets 0 6 12)
(Targets 0 -1 13)
(Targets 0 -5 14)
(Targets 0 -6 15)
(Targets 0 41 16)
(Targets 1 4 20)
(run derive 1)
