(datatype Group (GroupId i64))
(datatype Node (Inputs Group i64 i64) (Targets Group i64 i64)
               (AddHit i64 i64))
(ruleset derive)
(rule ((= parent (Inputs g a b)) (= target (Targets g expected tag)) (= expected (+ a b)))
      ((AddHit a tag)) :ruleset derive)
(Inputs (GroupId 0) 3 2)
(Inputs (GroupId 0) -3 2)
(Inputs (GroupId 1) 9223372036854775807 1)
(Targets (GroupId 0) 5 10)
(Targets (GroupId 0) 1 11)
(Targets (GroupId 0) 6 12)
(Targets (GroupId 0) -1 13)
(Targets (GroupId 0) -5 14)
(Targets (GroupId 0) -6 15)
(Targets (GroupId 0) 41 16)
(Targets (GroupId 1) 4 20)
(Inputs (GroupId 2) 4 5)
(Targets (GroupId 3) 9 27)
(ruleset merge-groups)
(rule ((= x (GroupId 2)) (= y (GroupId 3))) ((union x y)) :ruleset merge-groups)
(run derive 1)
(run merge-groups 1)
(run derive 1)
