(datatype KeyType (Key i64))
(datatype Node (Input KeyType i64) (Out i64 i64) (Label i64) (Long i64 i64))
(function LeftScore (KeyType) i64 :merge (min old new))
(function RightScore (KeyType) i64 :merge (min old new))
(ruleset derive)
(ruleset unrelated)
(ruleset fill)
(ruleset join)
(ruleset change)
(ruleset labels)
(rule ((= src (Input k id)) (= x (LeftScore k)) (= y (RightScore k)) (= s (+ x y)))
      ((Out id s)) :ruleset derive)
(rule ((= k (Key 99))) ((set (RightScore k) 51)) :ruleset unrelated)
(rule ((= k (Key 2))) ((set (RightScore k) 12)) :ruleset fill)
(rule ((= x (Key 1)) (= y (Key 3))) ((union x y)) :ruleset join)
(rule ((= k (Key 1))) ((set (LeftScore k) 1)) :ruleset change)
(rule ((= k (Key x))) ((Label x)) :ruleset labels)
(rule ((= a (Input k id)) (= x (LeftScore k))
       (= s1 (+ x id)) (= s2 (+ s1 id)) (= s3 (+ s2 id))
       (= s4 (+ s3 id)) (= s5 (+ s4 id)) (= s6 (+ s5 id))
       (= s7 (+ s6 id)) (= s8 (+ s7 id)) (= s9 (+ s8 id))
       (= s10 (+ s9 id)) (= s11 (+ s10 id)) (= s12 (+ s11 id)))
      ((Long id s12)) :ruleset labels)
(Input (Key 1) 1)
(Input (Key 2) 2)
(Input (Key 3) 3)
(Key 99)
(set (LeftScore (Key 1)) 4)
(set (RightScore (Key 1)) 7)
(set (LeftScore (Key 2)) 13)
(set (LeftScore (Key 3)) 20)
(run derive 1)
(run unrelated 1)
(run derive 1)
(run fill 1)
(run derive 1)
(run join 1)
(run derive 1)
(run change 1)
(run derive 1)
(run labels 1)
