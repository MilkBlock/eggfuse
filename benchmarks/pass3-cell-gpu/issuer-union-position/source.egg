(datatype Expr (Id i64) (Fabricated i64) (Wrap Expr) (Triple Expr Expr Expr))
(ruleset input-unions)
(ruleset constructed)
(rule ((= t (Triple a b c))) ((union a b) (union b c)) :ruleset input-unions)
(rule ((= e (Id i))) ((union e (Fabricated i))) :ruleset constructed)
(Triple (Id 1) (Id 2) (Id 3))
(Wrap (Id 1))
(Wrap (Id 2))
(Wrap (Id 3))
(Fabricated 1)
(run input-unions 1)
(run constructed 1)
