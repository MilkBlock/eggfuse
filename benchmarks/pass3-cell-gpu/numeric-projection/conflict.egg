(datatype Expr (Atom i64) (Concat Expr Expr) (Observe Expr))
(function Expr-size (Expr) i64 :merge (min old new))
(relation Seed (i64 i64))
(ruleset make)
(ruleset size)
(ruleset read)
(rule ((Seed id old))
      ((let x (Atom (* id 2))) (let y (Atom (+ (* id 2) 1)))
       (let z (Concat x y))
       (set (Expr-size x) 4) (set (Expr-size y) 7) (set (Expr-size z) old)
       (Observe z)) :ruleset make)
(rule ((= z (Concat x y)) (= combined (+ (Expr-size y) (Expr-size x))))
      ((set (Expr-size z) combined)) :ruleset size)
(rule ((= view (Observe z)) (= visible (Expr-size z)))
      ((set (Expr-size view) visible)) :ruleset read)
(Seed 0 9)
(Seed 1 15)
(run-schedule (seq (run make) (run size) (run read)))
