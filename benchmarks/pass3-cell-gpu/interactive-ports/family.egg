(datatype E (L i64) (R i64) (Tag i64) (Both E E) (C E) (D E) (Use E))
(ruleset first)
(ruleset advance)
(ruleset finish)
(rule ((= l (L i)) (= r (R i))) ((Both l r)) :ruleset first)
(rule ((= p (Both l r))) ((C p)) :ruleset advance)
(rule ((= t (Tag i))) ((D t)) :ruleset advance)
(rule ((= c (C p))) ((Use c)) :ruleset finish)
(L 1)
(R 1)
(Tag 0)
(run-schedule (seq (run first) (run advance) (run finish)))
