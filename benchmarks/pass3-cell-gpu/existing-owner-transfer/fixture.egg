(datatype E (N i64) (F E) (G E) (H E) (Seen E))
(relation OwnerReader (E))
(ruleset a)
(ruleset b)
(ruleset c)
(ruleset outside)
(ruleset idle)
(ruleset merge-inputs)
(rule ((= x (N n))) ((G (F x))) :ruleset a)
(rule ((= x (G y))) ((H x)) :ruleset b)
(rule ((= x (H y))) ((Seen x)) :ruleset c)
(rule ((= x (H y))) ((OwnerReader x) (OwnerReader y)) :ruleset outside)
(rule ((= x (N 0)) (= y (N 1))) ((union x y)) :ruleset merge-inputs)
(N 0)
(N 1)
(run-schedule (seq (run a) (run b) (run outside) (run c) (run idle) (run idle) (run merge-inputs) (run c)))
(check (= (H (G (F (N 0)))) (H (G (F (N 1)))) ))
