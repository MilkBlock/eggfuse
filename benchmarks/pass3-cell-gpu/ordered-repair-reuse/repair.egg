(datatype E (Leaf i64) (Pair E E) (Wrap E))
(sort ESet (Set E))
(datatype Bag (BagOf ESet))
(function Size (Bag) i64 :merge (min old new))
(function ValueAt (i64) E :merge new)
(ruleset observe)
(ruleset connect)
(ruleset repoint)
(ruleset second)
(ruleset finish)
(rule ((= bag (BagOf members))) ((set (Size bag) (set-length members))) :ruleset observe)
(rule ((= x (Leaf 1)) (= y (Leaf 2)) (= z (Leaf 3))) ((union x y) (union y z)) :ruleset connect)
(rule ((= a (Leaf 5))) ((set (ValueAt 19) a)) :ruleset repoint)
(rule ((= x (Leaf 4)) (= y (Leaf 5))) ((union x y)) :ruleset second)
(rule ((= x (Leaf 4)) (= x (ValueAt 19))) ((Wrap x)) :ruleset finish)
(Leaf 4)
(Leaf 5)
(Pair (Leaf 1) (Leaf 1))
(Pair (Leaf 2) (Leaf 2))
(Wrap (Pair (Leaf 3) (Leaf 2)))
(BagOf (set-of (Leaf 1) (Leaf 2) (Leaf 3)))
(set (ValueAt 19) (Leaf 3))
(run observe 1)
(run connect 1)
(run observe 1)
(run repoint 1)
(run second 1)
(run finish 1)
