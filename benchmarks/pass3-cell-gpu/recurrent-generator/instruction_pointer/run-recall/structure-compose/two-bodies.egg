(relation LeftSeed (i64))
(relation RightSeed (i64))
(relation LeftStage (i64))
(relation RightStage (i64))
(relation LeftOne (i64))
(relation LeftTwo (i64))
(relation RightOne (i64))
(relation RightTwo (i64))
(relation FirstBranch (i64))
(relation SecondBranch (i64))
(relation Complete (i64))
(ruleset seed)
(ruleset expose)
(ruleset branch)
(ruleset finish)
(rule ((LeftSeed x)) ((LeftStage x)) :ruleset seed :name "left-seed")
(rule ((RightSeed x)) ((RightStage x)) :ruleset seed :name "right-seed")
(rule ((LeftStage x)) ((LeftOne x) (LeftTwo x)) :ruleset expose :name "left-ports")
(rule ((RightStage x)) ((RightOne x) (RightTwo x)) :ruleset expose :name "right-ports")
(rule ((LeftOne x) (RightOne x)) ((FirstBranch x)) :ruleset branch :name "first")
(rule ((LeftTwo x) (RightTwo x)) ((SecondBranch x)) :ruleset branch :name "second")
(rule ((FirstBranch x) (SecondBranch x)) ((Complete x)) :ruleset finish :name "finish")
(LeftSeed 7) (RightSeed 7)
(run-schedule (seq (run seed) (run expose) (run branch) (run finish) (run seed)))
