(datatype E (A i64) (Seed E E) (Pair E E) (Always E) (EqualOnly E))
(ruleset make)
(ruleset consume)
(rule ((Seed x y)) ((Pair x y)) :ruleset make :name "independent_pair")
(rule ((= p (Pair x y))) ((Always p)) :ruleset consume :name "unguarded")
(rule ((= p (Pair x x))) ((EqualOnly p)) :ruleset consume :name "equal_arguments_only")
(Seed (A 0) (A 1))
(Seed (A 0) (A 2))
(union (A 0) (A 1))
(run-schedule (seq (run make) (run consume)))
