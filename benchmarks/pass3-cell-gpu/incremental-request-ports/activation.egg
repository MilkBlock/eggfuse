(datatype K (Key i64))
(datatype V (Val i64))
(datatype N (Target V i64) (Source K i64) (Matched i64 i64))
(function Attribute (K) V :merge old)
(ruleset derive)
(ruleset fill)
(ruleset add-target)
(ruleset join)
(rule ((= right (Target val rt)) (= val (Attribute key)) (= left (Source key lt)))
      ((Matched lt rt)) :ruleset derive)
(rule ((= k (Key 2))) ((set (Attribute k) (Val 2))) :ruleset fill)
(rule ((= v (Val 3))) ((Target v 13)) :ruleset add-target)
(rule ((= a (Val 4)) (= b (Val 1))) ((union a b)) :ruleset join)

(Source (Key 1) 1)
(Source (Key 2) 2)
(Source (Key 3) 3)
(Source (Key 4) 4)
(Target (Val 1) 11)
(Target (Val 2) 12)
(set (Attribute (Key 1)) (Val 1))
(set (Attribute (Key 3)) (Val 3))
(set (Attribute (Key 4)) (Val 4))
