(datatype Item (Id i64))
(datatype Pair (Value Item i64 i64) (PairKeys Item Item))
(function Score (Item i64) i64 :merge (min old new))
(ruleset scoring)
(ruleset joining)
(rule ((= r (Value k group x)))
      ((set (Score k group) (- (+ x 1) 3))) :ruleset scoring)
(rule ((= a (Id 1)) (= b (Id 2))) ((union a b)) :ruleset joining)
(Value (Id 1) 3 5)
(Value (Id 1) 3 8)
(Value (Id 1) 3 11)
(Value (Id 2) 3 4)
(Value (Id 2) 3 7)
(set (Score (Id 1) 3) 9)
(run scoring 1)
(run joining 1)
(run scoring 1)
