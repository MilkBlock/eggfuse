diff --git a/engine/cell-runtime/src/ownership_input_slots.rs b/engine/cell-runtime/src/ownership_input_slots.rs
new file mode 100644
index 00000000..9743bd7f
--- /dev/null
+++ b/engine/cell-runtime/src/ownership_input_slots.rs
@@ -0,0 +1,81 @@
+//! Entry evidence for otherwise unused source slots. This adds no signal,
+//! binding, runtime history or producer subscription. Normalized shapes keep
+//! only the projections common to every incoming route, including prefixes.
+use super::*;
+type Projection = (usize, usize, usize); // frame, source slot, existing symbol
+
+impl Shape {
+    pub(in crate::graph) fn input_symbol(&self, frame: usize, slot: usize) -> Option<usize> {
+        let slots = self.input_slots.as_deref()?;
+        let i = slots.binary_search_by_key(&(frame, slot), |&(f,s,_)| (f,s)).ok()?;
+        Some(slots[i].2)
+    }
+}
+impl Plan {
+    pub(super) fn prepare_input_slots(&mut self, p: &Program, markers: &[Marker],
+        programs: &[Arc<PortProgram>], entries: &[Vec<usize>]) {
+        // Every transition appends one frame. Solve by depth after all route
+        // aliases are known; an early prefix must not retain stronger evidence
+        // than a later route into the same normalized shape.
+        let mut shared = BTreeMap::<Vec<Projection>, Arc<Vec<Projection>>>::new();
+        for depth in 2..=self.max_frames {
+            for target in 0..self.shapes.len() {
+                if self.shapes[target].programs.len() != depth { continue; }
+                let mut common: Option<Vec<Projection>> = None;
+                for (key, _) in self.transitions.iter().filter(|(_,to)| *to == target) {
+                    let parent = &self.shapes[key.shape];
+                    let mut slots = parent.input_slots.as_deref().cloned().unwrap_or_default();
+                    let rule = &p.rules[key.hop.rule];
+                    let template = &p.templates[rule.template];
+                    let program = &markers[rule.template].program;
+                    let atom = &rule.query[entries[key.hop.rule][key.hop.entry]];
+                    let source = &programs[parent.programs[key.hop.source_frame]];
+                    for (column,arg) in atom.args.iter().enumerate() {
+                        let Arg::Slot(slot) = arg else { continue; };
+                        if program.slots[*slot].is_some() || template.defs.contains_key(slot) { continue; }
+                        let Some(local) = source.fields[key.hop.op as usize][column] else { continue; };
+                        let symbol = parent.ports[key.hop.source_frame][local];
+                        slots.push((depth-1,*slot,symbol));
+                    }
+                    slots.sort_unstable();
+                    slots.dedup_by_key(|s| (s.0,s.1));
+                    match &mut common {
+                        None => common = Some(slots),
+                        Some(common) => intersect(common, &slots),
+                    }
+                }
+                let slots = common.unwrap_or_default();
+                if !slots.is_empty() {
+                    let slots = shared.entry(slots.clone()).or_insert_with(|| Arc::new(slots)).clone();
+                    Arc::make_mut(&mut self.shapes[target]).input_slots = Some(slots);
+                }
+            }
+        }
+    }
+
+    pub(in crate::graph) fn input_slot_storage_bytes(&self) -> usize {
+        let mut seen = BTreeSet::new();
+        self.shapes.len() * std::mem::size_of::<Option<Arc<Vec<Projection>>>>()
+            + self.shapes.iter().filter_map(|s|s.input_slots.as_ref()).filter_map(|slots| {
+                seen.insert(Arc::as_ptr(slots) as usize).then(||
+                    std::mem::size_of::<Vec<Projection>>() + 2 * std::mem::size_of::<usize>()
+                    + slots.capacity() * std::mem::size_of::<Projection>())
+            }).sum::<usize>()
+    }
+}
+fn intersect(common: &mut Vec<Projection>, incoming: &[Projection]) {
+    common.retain(|slot| incoming.binary_search(slot).is_ok());
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn normalized_routes_keep_only_identical_slot_and_symbol_evidence() {
+        let mut first = vec![(0,1,2),(1,3,4),(1,5,6)];
+        intersect(&mut first,&[(0,1,7),(1,3,4),(1,9,6)]);
+        assert_eq!(first,vec![(1,3,4)]);
+        intersect(&mut first,&[]);
+        assert!(first.is_empty());
+    }
+}
