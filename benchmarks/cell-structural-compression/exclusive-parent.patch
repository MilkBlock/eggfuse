+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn exclusive_factless_source_moves_only_required_scalar_and_retires() {
+        let mut g=crate::query::test_projection_graph();
+        let base=g.program.templates.len();
+        g.program.templates.push(Template{name:"retired source".into(),sorts:vec![],
+            defs:Default::default(),parent_columns:Default::default(),
+            ops:vec![Op::Let(0,Call::Table(0),vec![Arg::Slot(1)])].into()});
+        g.program.templates.push(Template{name:"completed child".into(),sorts:vec![],
+            defs:Default::default(),parent_columns:[(0,0)].into_iter().collect(),ops:vec![].into()});
+        let rid=g.program.executions.len();
+        g.program.executions.push(crate::cell::execution::Plan{
+            parent_completion:Some(vec![0].into_boxed_slice()),..Default::default()});
+        let mut parent=Cell{symbolic_slots:false,completed_prefix:1,started_epoch:1,completed:true,
+            template:base,parent:None,values:Default::default(),facts:Default::default(),recipe_depth:0};
+        parent.values.insert(1,Value::Int(7));parent.values.insert(2,Value::Int(99));
+        g.cells.insert(100,parent);
+        g.cells.insert(101,Cell{symbolic_slots:false,completed_prefix:0,started_epoch:2,completed:true,
+            template:base+1,parent:Some(FactRef{cell:100,op:0}),values:Default::default(),
+            facts:Default::default(),recipe_depth:1});
+        g.parent_users.insert(100,2);
+        g.complete_parent_handoff(101,rid).unwrap();
+        assert!(g.cells.get(&101).unwrap().parent.is_some(),"shared source must not be copied");
+        assert!(g.cells.get(&101).unwrap().values.is_empty());
+        g.parent_users.insert(100,1);
+        g.complete_parent_handoff(101,rid).unwrap();
+        assert!(g.cells.get(&101).unwrap().parent.is_none());
+        assert_eq!(g.cells.get(&101).unwrap().values.len(),1);
+        assert_eq!(g.slot(101,0).unwrap(),Value::Int(7));
+        assert_eq!(g.stats.completed_parent_slots_materialized,1);
+        g.collect_garbage();
+        assert!(g.cells.get(&100).is_none(),"source record must retire through normal GC");
+        assert_eq!(g.slot(101,0).unwrap(),Value::Int(7));
+    }
+}
