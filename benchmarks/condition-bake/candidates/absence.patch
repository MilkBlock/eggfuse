+#[test]
+fn birth_miss_proof_requires_every_input_root_to_be_unaliased() {
+    let p = source(r#"
+(datatype E (N i64) (F E i64) (Pair E E))
+(N 0) (N 1)
+(run-schedule (run))
+"#);
+    let table = |name: &str| p.tables.iter().position(|t| t.name == name).unwrap();
+    let (n, f, pair) = (table("N"), table("F"), table("Pair"));
+    let mut graph = Graph::new_with_port_keys(p).unwrap();
+    let [a, b] = [0, 1].map(|i| graph.lookup(n, &[Value::Int(i)]).unwrap().unwrap().values[1].clone());
+    // Imported roots share Cell 0. Make c in a fresh Cell so its bit stays
+    // clear after the imported a/b class merges; the second-input check matters.
+    let c = graph.dynamic_construct(n, vec![Value::Int(2)]).unwrap();
+    let before = graph.stable_port_report();
+    assert!(graph.lookup(f, &[a.clone(), Value::Int(0)]).unwrap().is_none());
+    let missing = graph.stable_port_report();
+    assert_eq!(missing["stats"]["port_domain_probes"], before["stats"]["port_domain_probes"]);
+    assert_eq!(missing["stats"]["birth_absence_proofs"].as_u64().unwrap(),
+        before["stats"]["birth_absence_proofs"].as_u64().unwrap() + 1);
+    let value = graph.dynamic_construct(f, vec![b.clone(), Value::Int(0)]).unwrap();
+    graph.dynamic_construct(pair, vec![b.clone(), c.clone()]).unwrap();
+    graph.dynamic_construct(pair, vec![c.clone(), b.clone()]).unwrap();
+    graph.enqueue_union(a.clone(), b.clone()).unwrap();
+    graph.repair().unwrap();
+    let before = graph.stable_port_report();
+    // The birth hash still contains b. These current keys must reach it through
+    // equality, including when only the second input has received an alias.
+    assert_eq!(graph.lookup(f, &[a.clone(), Value::Int(0)]).unwrap().unwrap().values[2], value);
+    assert!(graph.lookup(pair, &[a.clone(), c.clone()]).unwrap().is_some());
+    assert!(graph.lookup(pair, &[c.clone(), a.clone()]).unwrap().is_some());
+    assert!(graph.lookup(f, &[a.clone(), Value::Int(1)]).unwrap().is_none());
+    let after = graph.stable_port_report();
+    assert!(after["stats"]["port_domain_probes"].as_u64().unwrap() > before["stats"]["port_domain_probes"].as_u64().unwrap());
+    graph.hide(f, &[a.clone(), Value::Int(0)], true).unwrap();
+    assert!(graph.lookup(f, &[a.clone(), Value::Int(0)]).unwrap().is_none());
+    graph.dynamic_construct(f, vec![a.clone(), Value::Int(0)]).unwrap();
+    assert!(graph.lookup(f, &[b, Value::Int(0)]).unwrap().is_some());
+}
