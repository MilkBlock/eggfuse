diff --git a/engine/cell-runtime/src/ownership_queries.rs b/engine/cell-runtime/src/ownership_queries.rs
new file mode 100644
--- /dev/null
+++ b/engine/cell-runtime/src/ownership_queries.rs
@@ -0,0 +1,27 @@
+//! A bound field addresses shared template code directly. These routes contain
+//! positions in immutable signal slices, never instance IDs or live consumers.
+use super::*;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Plan {
+    /// Symbol -> column -> positions in Shape::signals[symbol].
+    pub columns: Vec<Vec<Vec<usize>>>,
+}
+impl Plan {
+    pub fn derive(shape: &Shape) -> Self {
+        let columns = shape.signals.iter().map(|steps| {
+            let mut columns = Vec::<Vec<usize>>::new();
+            for (position, step) in steps.iter().enumerate() {
+                for &column in step.columns.iter() {
+                    columns.resize_with(columns.len().max(column + 1), Vec::new);
+                    columns[column].push(position);
+                }
+            }
+            columns
+        }).collect();
+        Self { columns }
+    }
+    pub fn positions(&self, symbol: usize, column: usize) -> &[usize] {
+        self.columns[symbol].get(column).map_or(&[], Vec::as_slice)
+    }
+}
diff --git a/engine/cell-runtime/src/parent_absence.rs b/engine/cell-runtime/src/parent_absence.rs
new file mode 100644
--- /dev/null
+++ b/engine/cell-runtime/src/parent_absence.rs
@@ -0,0 +1,33 @@
+//! Conservative incoming-union summary. A zero bit certifies that no equality
+//! ID in this Cell has received a parent edge. False positives only retain the
+//! complete lookup path. This is not a consumer index or a canonical-key cache.
+#[derive(Clone, Debug, Default)]
+pub(super) struct Directory {
+    words: Vec<u64>,
+    pub writes: u64,
+    pub growths: u64,
+    invalidated: bool,
+}
+const WORD_LIMIT: usize = 1 << 20;
+impl Directory {
+    fn address(id: u64) -> (usize, u64) {
+        let cell = (id >> 32) as usize;
+        (cell / 64, 1u64 << (cell % 64))
+    }
+    pub fn mark(&mut self, id: u64) {
+        if self.invalidated { return; }
+        self.writes += 1;
+        let (word, bit) = Self::address(id);
+        if word >= WORD_LIMIT { return; }
+        let before = self.words.capacity();
+        if word >= self.words.len() { self.words.resize(word + 1, 0); }
+        self.growths += u64::from(self.words.capacity() != before);
+        self.words[word] |= bit;
+    }
+    pub fn proves_unaliased_root(&self, id: u64) -> bool {
+        let (word, bit) = Self::address(id);
+        !self.invalidated && word < WORD_LIMIT && self.words.get(word).is_none_or(|bits| bits & bit == 0)
+    }
+    pub fn invalidate(&mut self) { self.invalidated = true; }
+    pub fn capacity_bytes(&self) -> usize { self.words.capacity() * std::mem::size_of::<u64>() }
+}
