+                stats.birth_absence_checks.set(stats.birth_absence_checks.get() + 1);
+                let Value::Eq(id) = key[column] else { unreachable!("checked input port") };
+                let proven = self.parents.proves_unaliased_root(id);
+                if !proven {
+                    stats.birth_absence_declines.set(stats.birth_absence_declines.get() + 1);
+                    if id >> 32 == 0 {
+                        stats.birth_absence_imported_declines.set(stats.birth_absence_imported_declines.get() + 1);
+                    }
+                }
+                proven
+            });
+            if unaliased {
+                stats.birth_absence_proofs.set(stats.birth_absence_proofs.get() + 1);
+                return Ok(None);
+            }
         }
         stats
             .port_domain_probes
