(datatype E (N i64) (Edge E i64) (Seen E i64))
(function Weight (E) i64 :merge (min old new))
(ruleset read) (ruleset change) (ruleset remove) (ruleset join) (ruleset restore)
(rule ((= n (Weight x)) (= e (Edge x tag))) ((Seen e n)) :ruleset read)
(rule ((= x (N 0))) ((set (Weight x) 9) (Edge x 3)) :ruleset change)
(rule ((= x (N 1))) ((delete (Edge x 1)) (set (Weight x) 19)) :ruleset remove)
(rule ((= x (N 0)) (= y (N 1))) ((union x y)) :ruleset join)
(rule ((= x (N 0))) ((subsume (Edge x 2)) (Edge x 1) (set (Weight x) 8)) :ruleset restore)
(Edge (N 0) 0) (Edge (N 1) 1) (Edge (N 1) 2)
(set (Weight (N 0)) 10) (set (Weight (N 1)) 20) (set (Weight (N 2)) 30)
(run-schedule (run read))
(check (Seen (Edge (N 0) 0) 10) (Seen (Edge (N 1) 1) 20) (Seen (Edge (N 1) 2) 20))
(run-schedule (seq (run change) (run read)))
(check (Seen (Edge (N 0) 0) 9) (Seen (Edge (N 0) 3) 9))
(run-schedule (seq (run remove) (run read)))
(check (Seen (Edge (N 1) 2) 19))
(run-schedule (seq (run join) (run read)))
(check (Seen (Edge (N 0) 2) 9))
(run-schedule (seq (run restore) (run read)))
(check (Seen (Edge (N 0) 0) 8) (Seen (Edge (N 0) 1) 8) (Seen (Edge (N 0) 3) 8))
