(datatype E (N i64) (F E E i64) (G E) (Out E i64) (Keep E))
(relation Edge (E i64))
(ruleset make) (ruleset read) (ruleset keep)
(rule ((= x (N n)))
 ((G (F x x 7)) (G (F x (N 9) 7)) (G (F x x 8)))
 :ruleset make :name "producer")
(rule ((= f (F x x 7)) (= g (G f)) (Edge x n))
 ((Out (G (F x x 7)) n)) :ruleset read :name "consumer")
(rule ((= f (F x x 7)) (= g (G f)))
 ((Keep (G (F x x 7)))) :ruleset keep :name "keeper")
(G (F (N 0) (N 0) 7)) (N 1)
(Edge (N 0) 10) (Edge (N 1) 11) (Edge (N 1) 12)
(run-schedule (seq (run make) (run read) (run keep)))
(check (Out (G (F (N 0) (N 0) 7)) 10)
       (Out (G (F (N 1) (N 1) 7)) 11)
       (Out (G (F (N 1) (N 1) 7)) 12))
