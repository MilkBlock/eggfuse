(datatype E (Anchor) (Item i64) (Cost i64 i64) (Choice E E) (Observed i64)
            (Wrap E) (Left E) (Right E))
(function Ticket (E E E i64) Unit :merge old)
(ruleset publish) (ruleset consume) (ruleset late) (ruleset wake) (ruleset wrap) (ruleset collide)
(rule ((= t (Wrap (Item i)))) ((Left t)) :ruleset wrap :name "left")
(rule ((= t (Wrap (Item i)))) ((Right t)) :ruleset wrap :name "right")
(rule ((= v (Choice a b)) (= b (Cost token bound)))
      ((set (Ticket v a b bound) ())) :ruleset publish)
(rule ((Ticket v a b bound) (= a (Cost token cost)) (< cost bound))
      ((union v a) (set (Ticket a a b bound) ()) (Observed 0)) :ruleset consume)
(rule ((Ticket v a b bound) (= a (Cost token cost)) (> cost bound))
      ((union v b) (set (Ticket b a b bound) ()) (Observed 1)) :ruleset consume)
(rule ((Ticket v a b cost) (= a (Cost token cost)))
      ((union v a) (set (Ticket a a b cost) ()) (Observed 2)) :ruleset consume)
(rule ((= a (Item 8))) ((union a (Cost 33 -5))) :ruleset late)
(rule ((= b (Cost 2 6))) ((union b (Anchor))) :ruleset wake)
(rule ((= a (Cost 1 3)) (= b (Cost 1 6))) ((union a b)) :ruleset collide)
(Anchor)
(Wrap (Item 8)) (Wrap (Cost 33 -5))
(Choice (Cost 1 3) (Cost 2 6))
(Choice (Cost 1 9) (Cost 2 6))
(Choice (Cost 1 6) (Cost 2 6))
(Choice (Item 8) (Cost 2 6))
(run-schedule (seq (run wrap) (run publish) (run consume) (run late) (run consume)
                   (run wake) (run publish) (run consume) (run collide) (run consume) (run wrap)))
(check (= less (Observed 0)) (= greater (Observed 1)) (= equal (Observed 2)))
