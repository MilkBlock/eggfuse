(datatype E (N i64) (F E) (Fresh E) (Out E i64))
(function score (E) i64 :merge new)
(ruleset alias) (ruleset remove) (ruleset rebuild) (ruleset update) (ruleset read)
(rule ((F x)) ((F x)) :ruleset alias)
(rule ((F x)) ((delete (F x))) :ruleset remove)
(rule ((= x (N 1))) ((F x) (Fresh x)) :ruleset rebuild)
(rule ((F x)) ((set (score x) 2)) :ruleset update)
(rule ((F x) (= n (score x))) ((Out x (+ n 1))) :ruleset read)
(F (N 1)) (set (score (N 1)) 1)
(run-schedule (seq (run alias) (run read) (run remove) (run rebuild) (run alias) (run update) (run read)))
(check (Out (N 1) 2) (Out (N 1) 3) (Fresh (N 1)) (= (score (N 1)) 2))
