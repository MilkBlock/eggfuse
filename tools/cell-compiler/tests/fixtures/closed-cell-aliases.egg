(datatype E (N i64) (Seed E) (Start E) (Mark E) (Tail E) (Gateway E) (Out E E))
(ruleset seed) (ruleset make) (ruleset consume) (ruleset retire) (ruleset observe)
(rule ((Seed x)) ((Start x)) :ruleset seed)
(rule ((Start x)) ((Mark x) (Tail x) (Gateway x)) :ruleset make :name "producer")
(rule ((Gateway x))
 ((Gateway x) (let m (Mark x)) (Mark x) (union m x) (Tail x) (Tail x))
 :ruleset consume :name "consumer")
(rule ((= x (N 2))) ((delete (Tail x))) :ruleset retire)
(rule ((= m (Mark x)) (Tail x)) ((Out m x)) :ruleset observe)
(Seed (N 1)) (Seed (N 2))
(run-schedule (seq (run seed) (run make) (run retire) (run consume) (run observe)))
(check (Out (Mark (N 1)) (N 1)) (Out (Mark (N 2)) (N 2)))
