(datatype E (N i64) (Start E) (Gate E))
(relation Choice (E i64))
(function Cost (E) i64 :merge new)
(function Result (E i64) i64 :merge new)
(ruleset make) (ruleset see) (ruleset fill) (ruleset remove) (ruleset restore)
(rule ((Start x)) ((Gate x) (Choice x 10) (Choice x 11)) :ruleset make)
(rule ((Gate x) (Choice x n) (= c (Cost x)) (> n 0))
      ((set (Result x n) (+ c n))) :ruleset see)
(rule ((Start (N 7))) ((set (Cost (N 7)) 7)) :ruleset fill)
(rule ((Start (N 0))) ((delete (Choice (N 0) 10))) :ruleset remove)
(rule ((Start (N 0))) ((Choice (N 0) 10) (set (Cost (N 0)) 9)) :ruleset restore)
(Start (N 0)) (Start (N 1)) (Start (N 2)) (Start (N 3))
(Start (N 4)) (Start (N 5)) (Start (N 6)) (Start (N 7))
(set (Cost (N 0)) 0) (set (Cost (N 1)) 1) (set (Cost (N 2)) 2)
(set (Cost (N 3)) 3) (set (Cost (N 4)) 4) (set (Cost (N 5)) 5) (set (Cost (N 6)) 6)
; Same query and table, but these initial facts have no producer publication.
(Gate (N 100)) (Choice (N 100) 12) (Choice (N 100) -1)
(set (Cost (N 100)) 100)
(run-schedule (seq (run make) (run see)))
(check (= (Result (N 0) 10) 10) (= (Result (N 0) 11) 11)
       (= (Result (N 6) 10) 16) (= (Result (N 100) 12) 112))
(run-schedule (seq (run fill) (run see)))
(check (= (Result (N 7) 10) 17) (= (Result (N 7) 11) 18))
(run-schedule (seq (run remove) (run see) (run restore) (run see)))
(check (= (Result (N 0) 10) 19) (= (Result (N 0) 11) 20))
