(datatype E (N i64) (Start E E) (F E) (Gateway E) (Out E))
(ruleset make) (ruleset consume) (ruleset retire) (ruleset again)
(rule ((Start x y)) ((F x) (Gateway x) (F y) (Gateway y) (union x y)) :ruleset make)
(rule ((Start x y)) ((Gateway x) (F x)) :ruleset make)
(rule ((Gateway x) (= f (F x))) ((Out f)) :ruleset consume)
(rule ((= x (N 1))) ((delete (F x))) :ruleset retire)
(rule ((Start x y)) ((F x) (Gateway x)) :ruleset again)
(Start (N 1) (N 2)) (Start (N 3) (N 4))
(run-schedule (seq (run make) (run consume) (run retire) (run consume) (run again) (run consume)))
(check (Out (F (N 1))) (Out (F (N 3))))
