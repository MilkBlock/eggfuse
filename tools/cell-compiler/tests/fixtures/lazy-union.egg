(datatype E (N i64) (Start E) (Left E) (Right E) (Gateway E) (Mid E) (Wrap E) (Seen E))
(ruleset init) (ruleset a) (ruleset b) (ruleset c) (ruleset observe)
(rule ((= x (N i))) ((Start x)) :ruleset init :name "start")
(rule ((= s (Start x))) ((Left x) (Right x) (Gateway x)) :ruleset a :name "producer")
(rule ((= g (Gateway x))) ((Mid x)) :ruleset b :name "bridge")
(rule ((= m (Mid x)))
      ((Left x) (Right x) (union (Left x) x) (union (Right x) (Left x)))
      :ruleset c :name "consume")
(rule ((= wrapped (Wrap (Left x))) (= wrapped (Wrap (Right x))))
      ((Seen x)) :ruleset observe)
(N 1) (N 2) (Start (Right (N 3)))
(Wrap (Left (N 1))) (Wrap (Right (N 1)))
(run-schedule (seq (run init) (run a) (run b) (run c) (run observe)))
(check (= (Left (N 1)) (N 1)))
(check (= (Wrap (Left (N 1))) (Wrap (Right (N 1)))))
(check (Seen (N 1)))
