(datatype E (N i64) (F E) (G E) (Seed i64) (Gateway E) (Out E) (Choice i64))
(ruleset make) (ruleset complete) (ruleset observe) (ruleset late)
(rule ((Seed 1)) ((Seed 2)) :ruleset late)
(rule ((Seed i)) ((let x (N i)) (F x) (G x) (Gateway x)) :ruleset make :name "producer")
(rule ((Gateway x) (= f (F x)) (= g (G x)) (Choice i))
      ((F x) (G x) (union f g) (union g f)) :ruleset complete :name "matched")
(rule ((= f (F x)) (= g (G x)) (= f g)) ((Out f)) :ruleset observe :name "observer")
(Seed 1) (Choice 7) (Choice 8)
(run-schedule (seq (run make) (run complete) (run observe)))
(run-schedule (seq (run late) (run make) (run complete) (run observe)))
(check (= (F (N 1)) (G (N 1))) (= (F (N 2)) (G (N 2))))
(check (Out (F (N 1))) (Out (G (N 2))))
